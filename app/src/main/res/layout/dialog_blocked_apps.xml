<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/blockedAppsRecycler"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAddBlockedApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Добавить приложение"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAddAllApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Добавить ВСЕ приложения"
        android:textSize="14sp"
        android:backgroundTint="#FF5722"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDeleteAllApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Удалить ВСЕ приложения"
        android:textSize="14sp"
        android:backgroundTint="#F44336" />

</LinearLayout>
